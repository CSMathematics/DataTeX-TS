{
  "name": "DataTeX",
  "private": true,
  "version": "2.1.1",
  "type": "module",
  "scripts": {
    "predev": "pnpm run build:stoicheia:css",
    "dev": "./node_modules/.bin/vite",
    "prebuild": "pnpm run check:stoicheia:copy && pnpm run test:stoicheia:parity && pnpm run build:stoicheia:css",
    "build": "tsc && node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build",
    "test:latex-highlighting": "node scripts/test-latex-highlighting.mjs",
    "test:package-studio": "node scripts/test-package-studio.mjs",
    "test:workflows": "node --test scripts/test-workflows.mjs",
    "test:stoicheia": "vitest run --config vitest.config.ts",
    "test:stoicheia:parity": "node scripts/check-stoicheia-parity.mjs && pnpm run test:stoicheia:golden && pnpm run test:stoicheia:parser-render",
    "test:stoicheia:golden": "vitest run --config vitest.config.ts src/features/stoicheia/parity/generatedLatexParity.test.ts",
    "test:stoicheia:parser-render": "pnpm run test:stoicheia:parser-render:native && pnpm run test:stoicheia:parser-render:frontend",
    "test:stoicheia:parser-render:native": "cargo test --manifest-path src-tauri/crates/stoicheia-engine/Cargo.toml --test parser_render_parity",
    "test:stoicheia:parser-render:frontend": "vitest run --config vitest.config.ts src/features/stoicheia/parity/parserRenderParity.test.tsx",
    "test:stoicheia:native": "cargo test --manifest-path src-tauri/crates/stoicheia-engine/Cargo.toml --test native_exact_preview -- --nocapture && cargo test --manifest-path src-tauri/Cargo.toml --lib package_studio::stoicheia_process::native_smoke_tests -- --nocapture",
    "build:stoicheia:css": "node scripts/build-stoicheia-css.mjs",
    "check:stoicheia:css": "node --test scripts/scope-stoicheia-css.test.mjs && node scripts/build-stoicheia-css.mjs --check",
    "check:stoicheia:copy": "node scripts/check-stoicheia-copy-baseline.mjs",
    "test:stoicheia:lazy": "pnpm run build:stoicheia:css && node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build --manifest --logLevel error && node scripts/check-stoicheia-lazy-build.mjs",
    "perf:stoicheia": "node scripts/run-stoicheia-performance.mjs",
    "perf:stoicheia:native": "cargo run --release --quiet --manifest-path src-tauri/crates/stoicheia-engine/Cargo.toml --example performance_report",
    "perf:stoicheia:render": "node scripts/run-stoicheia-render-benchmark.mjs",
    "preview": "vite preview",
    "tauri": "node scripts/run-tauri.mjs",
    "tauri:debug": "RUST_BACKTRACE=full DATATEX_DEBUG=1 node scripts/run-tauri.mjs dev",
    "tauri:build:linux": "node scripts/run-tauri.mjs build --config src-tauri/tauri.linux.conf.json",
    "tauri:build:windows": "node scripts/run-tauri.mjs build --config src-tauri/tauri.windows.conf.json",
    "tauri:build:macos:x64": "node scripts/run-tauri.mjs build --config src-tauri/tauri.macos-x86_64.conf.json",
    "tauri:build:macos:arm64": "node scripts/run-tauri.mjs build --config src-tauri/tauri.macos-aarch64.conf.json",
    "tauri:compat": "WEBKIT_DISABLE_DMABUF_RENDERER=1 node scripts/run-tauri.mjs",
    "tauri:software": "WEBKIT_DISABLE_DMABUF_RENDERER=1 WEBKIT_DISABLE_COMPOSITING_MODE=1 node scripts/run-tauri.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fortawesome/fontawesome-svg-core": "^7.1.0",
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "@fortawesome/react-fontawesome": "^3.1.1",
    "@mantine/core": "^8.3.10",
    "@mantine/hooks": "^8.3.10",
    "@mantine/notifications": "^8.3.10",
    "@monaco-editor/react": "^4.7.0",
    "@react-pdf/renderer": "^4.3.1",
    "@tabler/icons-react": "^3.36.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.4.2",
    "@tauri-apps/plugin-fs": "^2.4.4",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-sql": "~2.3.1",
    "@types/lodash": "^4.17.21",
    "@types/react-virtualized-auto-sizer": "^1.0.8",
    "@types/react-window": "^2.0.0",
    "@types/uuid": "^11.0.0",
    "antd": "^6.1.1",
    "date-fns": "^4.1.0",
    "i18next": "^25.7.4",
    "i18next-browser-languagedetector": "^8.2.0",
    "katex": "^0.16.27",
    "lodash": "^4.17.21",
    "lucide-react": "^1.27.0",
    "mathjs": "^15.1.0",
    "monaco-editor": "^0.55.1",
    "postcss": "^8.5.6",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-fontpicker-ts": "^1.3.0",
    "react-force-graph-2d": "^1.29.0",
    "react-i18next": "^16.5.3",
    "react-markdown": "^10.1.0",
    "react-virtualized-auto-sizer": "^2.0.2",
    "react-window": "^2.2.5",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "use-debounce": "^10.1.0",
    "uuid": "^13.0.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.10"
  }
}
